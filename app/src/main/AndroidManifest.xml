<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Brak uprawnienia CAMERA: ML Kit Document Scanner robi zdjęcia w procesie Google Play services
        (decyzja w PR #82). Brak RECORD_AUDIO: dyktowanie przez systemowe RecognizerIntent (PR #103).
    -->

    <!-- Opcjonalne miejsce poznania kontaktu (WF-24): przybliżona lokalizacja, prośba dopiero po
         dotknięciu „Dodaj miejsce” i z wyjaśnieniem celu (WNF-04). Bez dokładnej lokalizacji. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Backup wyłączony: baza jest szyfrowana kluczem z Android Keystore, który nie przenosi się
         na inne urządzenie, a dane kontaktowe nie powinny trafiać do chmury (eksport ręczny – Etap 5). -->
    <application
        android:name=".WizytowkiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WizytowkiApp"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WizytowkiApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
